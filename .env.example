# Copy this file to ".env" and fill in your secrets.
# Netlify Dev automatically loads .env into process.env.
# In Netlify (production), set these in Site Settings > Build & deploy > Environment.

# MongoDB connection string (e.g., from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# JWT secret used to sign authentication tokens
# Use a long, random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: override the frontend API base URL
# By default, js/config.js points to /.netlify/functions/auth (prod) and http://localhost:8888/.netlify/functions/auth (dev)
# Uncomment to force a custom API base (rarely needed)
# PIGGYBANKS_API_BASE_URL=https://your-site.netlify.app/.netlify/functions/auth

